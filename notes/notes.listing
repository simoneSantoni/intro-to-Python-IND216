# import pandas with the socially accepted alias 'pd'
>>> import pandas as pd

# the data
>>> df0 = pd.DataFrame.from_dict(
...     {"product": [1, 2, 3], "sales": [10, 30, 20]}
...     )
>>> df1 = pd.DataFrame.from_dict(
...     {"product": [2, 3, 4], "margin": [0.13, 0.31, 0.21]}
...     )

# merge on a shared column. NOTE the key is "product" -- a misspelt key
# raises KeyError rather than falling back to anything
>>> pd.merge(df0, df1, on="product", how="left")
   product  sales  margin
0        1     10     NaN
1        2     30    0.13
2        3     20    0.31
>>> pd.merge(df0, df1, on="product", how="right")
   product  sales  margin
0        2   30.0    0.13
1        3   20.0    0.31
2        4    NaN    0.21
>>> pd.merge(df0, df1, on="product", how="outer")
   product  sales  margin
0        1   10.0     NaN
1        2   30.0    0.13
2        3   20.0    0.31
3        4    NaN    0.21
>>> pd.merge(df0, df1, on="product", how="inner")
   product  sales  margin
0        2     30    0.13
1        3     20    0.31

# merge on the index instead
>>> df0.set_index("product", inplace=True)
>>> df1.set_index("product", inplace=True)
>>> pd.merge(df0, df1, left_index=True, right_index=True)
         sales  margin
product
2           30    0.13
3           20    0.31
